{
  "name": "joemocode-llm-plugins",
  "version": "0.1.0",
  "description": "Reusable agent plugins for Claude Code, Cursor, opencode, and Pi. Abandoned in favor of using Pi exclusively.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joemocode-business/joemocode-llm-plugins"
  },
  "author": "Joe Muoio",
  "homepage": "https://github.com/joemocode-business/joemocode-llm-plugins",
  "keywords": ["pi-package", "claude-code", "cursor", "opencode", "plugins"],
  "pi": {
    "skills": ["./plugins/*/skills/*"],
    "extensions": [
      "./plugins/plan-to-agents/pi/extensions/subagent/index.ts",
      "./plugins/plan-to-agents/pi/extensions/question.ts",
      "./plugins/session-handoff/pi/extensions/precompact-handoff.ts"
    ],
    "prompts": ["./plugins/plan-to-agents/pi/prompts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.1.38"
  }
}
